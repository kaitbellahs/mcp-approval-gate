{
  "name": "mcp-approval-gate",
  "version": "0.1.0",
  "description": "MCP server that holds irreversible tool calls until a human approves them, with a tamper-evident audit log.",
  "type": "module",
  "license": "MIT",
  "author": "Khalid Ait Bellahs",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "approval-gate": "dist/cli.js",
    "approval-gate-server": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "server": "tsx src/server.ts",
    "gate": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
